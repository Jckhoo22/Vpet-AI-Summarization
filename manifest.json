{
    "name": "AiPaw",
    "version": "1.0.0",
    "description": "This extension generates a vpet and tracks your browsing content in real time to generate notes.",
    "manifest_version": 3,
    "permissions": ["scripting","activeTab", "tabs", "sidePanel", "downloads"],
    "host_permissions": [
        "https://generativelanguage.googleapis.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },

    "content_scripts": [
    {
    "matches": ["<all_urls>"],
    "js": ["libs/Readability.js", "user_code/extract_text.js"]
    }
  ],

    "side_panel": {
        "default_path": "index.html"
    }
}
